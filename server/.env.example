# Backend Server Port
PORT=5001

# MongoDB Connection URI (Local or MongoDB Atlas Cloud URI for production)
# Local: mongodb://127.0.0.1:27017/sih_scholarship
# Production Atlas: mongodb+srv://<username>:<password>@<cluster-url>/sih_scholarship?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sih_scholarship

# JWT Authentication Secret Key (Use a strong random string in production)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters

# JWT Expiration Duration
JWT_EXPIRE=7d

# Environment: 'development' or 'production'
NODE_ENV=development

# Frontend Client URL (For CORS whitelist in production, e.g. https://your-scholarship-app.vercel.app)
CLIENT_URL=http://localhost:5173

# ==========================================
# Real Email OTP Configuration (Nodemailer)
# ==========================================
# For Gmail: Use your Gmail address and a 16-character App Password
# (Google Account -> Security -> 2-Step Verification -> App Passwords)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-app-password
EMAIL_FROM="Ministry of Tribal Affairs" <no-reply@mota.gov.in>

# (Optional: If using custom SMTP like SendGrid, Brevo, Mailgun, AWS SES)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
